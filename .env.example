# Uplink (This servers address + listening port)
UPLINK_HOST=localhost
UPLINK_PORT=12000

# Backend (Spring API) (This servers api listening port)
SPRING_PORT=9001

# Frontend (Vite) (This servers http listening port)
VITE_PORT=8080

# Video (Satelites address + video server port)
VIDEO_HOST=localhost
VIDEO_PORT=8081

# Mail client
# Note: wont work with providers using advanced sighn in protocols (such as microsoft)
MAIL_USERNAME= #
MAIL_PASSWORD= #
MAIL_HOST= #address of smtp server
TELEMETRY_REPORT_ATTACHMENT_NAME=health-report.txt